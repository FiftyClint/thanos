# ── Required ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgres://thanos:thanos-local-dev@localhost:5432/thanos

# Required in production. Generate one with:  openssl rand -hex 32
# Rotating it logs everyone out and invalidates in-flight photo uploads.
SESSION_SECRET=

# ── Server ───────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=5000
HOST=0.0.0.0
LOG_LEVEL=info
# Hops of reverse proxy in front of the app (Fly/Railway/nginx = 1).
TRUST_PROXY=1
# Set false once your account exists to close the instance to new signups.
ALLOW_REGISTRATION=true
SESSION_TTL_DAYS=30

# ── Database ─────────────────────────────────────────────────────────────────
# true for a managed Postgres that requires TLS (Neon, Supabase, RDS).
DATABASE_SSL=false
# Apply migrations and sync program content on boot.
AUTO_MIGRATE=true
AUTO_SEED=true

# ── Progress photos ──────────────────────────────────────────────────────────
# local = a disk volume (default). s3 = any S3-compatible bucket.
FILE_STORE=local
UPLOAD_DIR=./data
MAX_UPLOAD_BYTES=15728640

# Only needed when FILE_STORE=s3
# S3_BUCKET=
# S3_REGION=auto
# S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_FORCE_PATH_STYLE=false

# ── Optional Notion mirror ───────────────────────────────────────────────────
# Leave NOTION_API_KEY unset to disable the mirror entirely.
# NOTION_API_KEY=
# NOTION_DB_TRAINING_SESSIONS=
# NOTION_DB_BODY_COMPOSITION=
# NOTION_DB_BODY_MEASUREMENTS=
# NOTION_DB_DAILY_VITALS=

# ── Tests ────────────────────────────────────────────────────────────────────
# Point at a throwaway database to enable the integration suite.
# TEST_DATABASE_URL=postgres://postgres@localhost:5432/thanos_test
